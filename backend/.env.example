# Flask
PORT=5000
FLASK_DEBUG=1
APP_SECRET_KEY=change-me-32-byte-random-string
SECRET_KEY=change-me-32-byte-random-string

# Auth/session
SESSION_TIMEOUT=60

# ============================================================================
# OpenAI-Compatible GenAI Service (Strict Single Provider)
# ============================================================================
LLM_PROVIDER=openai
OPENAI_BASE_URL=https://your-org-shared-service-url/v1
OPENAI_API_KEY=your_org_api_key_or_token
OPENAI_MODEL=gpt-5.6-luna
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_TIMEOUT=60

# Gateway / Corporate Settings:
OPENAI_SKIP_CONNECTION_CHECK=true
OPENAI_VERIFY_SSL=true

# App defaults
DEFAULT_DATASET_ROWS=10000
DEBUG_MODE=True
CORS_ORIGINS=http://localhost:5173,http://localhost:5000
MAX_UPLOAD_SIZE=50
RATE_LIMIT=100
