# Flask
PORT=5000
FLASK_DEBUG=1
APP_SECRET_KEY=change-me-32-byte-random-string
SECRET_KEY=change-me-32-byte-random-string

# Auth/session
MFA_BYPASS_ENABLED=true
SESSION_TIMEOUT=60

# API Providers
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_BASE_URL=http://localhost:11434

# App defaults
DEFAULT_DATASET_ROWS=10000
DEBUG_MODE=True
CORS_ORIGINS=http://localhost:5173,http://localhost:5000
MAX_UPLOAD_SIZE=50
RATE_LIMIT=100

# Optional
# AML_AUTO_BOOTSTRAP_VENV=1
# AML_BACKEND_PROFILE=mlops  # full|mlops (mlops loads only MLOps-related routes/services)
