# Flask
PORT=5000
FLASK_DEBUG=1
APP_SECRET_KEY=change-me-32-byte-random-string
SECRET_KEY=change-me-32-byte-random-string

# Auth/session
SESSION_TIMEOUT=60

# API Providers
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Local AI provider for Sentinel/FCC narratives.
# Put approved .gguf files in this folder, or leave LLM_ALLOW_DOWNLOAD=true on a developer laptop.
LLM_PROVIDER=gpt4all
LLM_MODEL_DIR=./data/local_models
GPT4ALL_DEFAULT_MODEL=qwen2-1_5b-instruct-q4_0.gguf
GPT4ALL_EMBED_MODEL=nomic-embed-text-v1.5.f16.gguf
LLM_ALLOW_DOWNLOAD=true
LLM_ENABLE_OLLAMA_FALLBACK=false
LLM_CONTEXT_WINDOW=2048
LLM_MAX_TOKENS=320
LLM_TOKEN_CAP=320

# Ollama is disabled by default. Uncomment only if you run an Ollama daemon.
# OLLAMA_BASE_URL=http://localhost:11434

# App defaults
DEFAULT_DATASET_ROWS=10000
DEBUG_MODE=True
CORS_ORIGINS=http://localhost:5173,http://localhost:5000
MAX_UPLOAD_SIZE=50
RATE_LIMIT=100

# Optional
# AML_AUTO_BOOTSTRAP_VENV=1
# AML_BACKEND_PROFILE=mlops  # full|mlops (mlops loads only MLOps-related routes/services)
